{
  "version": 2,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/server.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/(js|css|images|assets)/(.*)",
      "destination": "/public/$1/$2"
    },
    {
      "source": "/style.css",
      "destination": "/public/style.css"
    },
    {
      "source": "/data.js",
      "destination": "/public/data.js"
    },
    {
      "source": "/ads.txt",
      "destination": "/public/ads.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/public/robots.txt"
    },
    {
      "source": "/((?!api/|.*\\.).*)",
      "destination": "/server.js"
    }
  ]
}
